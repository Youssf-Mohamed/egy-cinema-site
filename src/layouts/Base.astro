            <img src="/images/login/tt37287335.webp" alt="" width="210" height="315" loading="lazy" decoding="async" />
          </div>
        </div>
      </div>
      <div class="site-bg__overlay"></div>
      <div class="site-bg__grain"></div>
      <div class="site-bg__vignette"></div>
    </div>
    {!hideNav && (
      <header class="site-header">
        <div class="site-header__inner container">
          <a href={hrefFor(locale)} class="site-nav__brand" aria-label="EGY CINEMA home">
            <span class="site-nav__brand-logo-wrap">
              <img src="/logo.png" alt="EGY CINEMA" width="28" height="28" style="border-radius: 6px; display: block;" />
