            <ul class="site-nav__links">
              {navLinks.map((l) => (
                <li><a href={l.href} class="site-nav__link">{l.label}</a></li>
              ))}
            </ul>
            <div class="site-nav__actions">
              <div class="lang-switch" aria-label="Language switcher">
                <a
                  href={enHref}
                  class:list={['lang-switch__btn', locale === 'en' ? 'lang-switch__btn--active' : null]}
                  aria-current={locale === 'en' ? 'true' : 'false'}
                  hreflang="en"
                  data-locale="en"
                >EN</a>
                <span class="lang-switch__divider" aria-hidden="true">/</span>
                <a
                  href={arHref}
                  class:list={['lang-switch__btn', locale === 'ar' ? 'lang-switch__btn--active' : null]}
                  aria-current={locale === 'ar' ? 'true' : 'false'}
                  hreflang="ar"
                  data-locale="ar"
                >AR</a>
              </div>
              <a href={`${hrefFor(locale)}#install`} class="site-nav__quick-cta">
