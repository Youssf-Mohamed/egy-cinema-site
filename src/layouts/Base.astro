---
import '../styles/global.css';

import type { Locale } from '../i18n/ui';
import { defaultLocale, localeDir, locales, t } from '../i18n/ui';
import { buildHreflang, SITE_URL } from '../lib/seo';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  path: string;
  type?: 'website' | 'article';
  image?: string;
  publishedTime?: string;
  modifiedTime?: string;
  jsonLd?: Record<string, unknown>[];
  hideNav?: boolean;
  hideFooter?: boolean;
  lang?: string;
}

const {
  locale, title, description, path,
  type = 'website', image, publishedTime, modifiedTime,
  jsonLd = [], hideNav, hideFooter, lang,
} = Astro.props;

const dir = localeDir[locale];
const canonical = buildHreflang(locale, path);
const ogImage = image ?? `${SITE_URL}/og-image.png`;
const fullTitle = title.includes('EGY CINEMA') ? title : `${title} — EGY CINEMA`;

const otherLocale = locales.find((l) => l !== locale)!;
const altHref = buildHreflang(otherLocale, path);

// Strip the current locale prefix from `path` so we can re-prefix it with the
// target locale. For the default locale (en, prefixDefaultLocale: false)
// the path keeps no prefix; for non-default (ar) the path starts with /ar.
const stripLocale = (p: string): string => {
  for (const loc of locales) {
    if (loc === defaultLocale) continue;
    const prefix = `/${loc}`;
    if (p === prefix) return '/';
    if (p.startsWith(prefix + '/')) return p.slice(prefix.length);
  }
  return p;
};
const basePath = stripLocale(path);
const enHref = `/${defaultLocale}${basePath === '/' ? '' : basePath}`;
const arHref = `/ar${basePath === '/' ? '' : basePath}`;
const hrefFor = (loc: Locale) => (loc === 'en' ? enHref : arHref);

const navLinks = [
  { href: `${hrefFor(locale)}#features`, label: t(locale, 'nav.features') },
  { href: `${hrefFor(locale)}#install`, label: t(locale, 'nav.download') },
  { href: `${hrefFor(locale)}/changelog`, label: t(locale, 'nav.changelog') },
];
---

<!doctype html>
<html lang={lang ?? locale} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#131313" />

    {/* Preconnect to speed up font loading */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />

    {/* Non-blocking Google Fonts — Cairo (display) + IBM Plex Mono (slate) */}
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&family=IBM+Plex+Mono:wght@400;500&display=swap"
      media="print"
      onload="this.media='all'"
    />
    {/* Fallback for JS-disabled browsers */}
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&family=IBM+Plex+Mono:wght@400;500&display=swap"
      />
    </noscript>

    {/* Preload LCP image — hero mockup */}
    <link rel="preload" as="image" href="/images/mockup/desktop-preview.webp" fetchpriority="high" />

    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={t(locale, 'site.keywords')} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="author" content="EGY CINEMA" />
    <link rel="canonical" href={canonical} />

    <link rel="alternate" hreflang={locale} href={canonical} />
    <link rel="alternate" hreflang={otherLocale} href={altHref} />
    <link rel="alternate" hreflang="x-default" href={buildHreflang('en', path)} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="EGY CINEMA" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta property="og:locale" content={locale === 'ar' ? 'ar_EG' : 'en_US'} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@egy_cinema" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd.map((obj) => (
      <script type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}

  </head>

