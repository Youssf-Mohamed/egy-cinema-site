---
import '../styles/global.css';
import '@fontsource/cairo/400.css';
import '@fontsource/cairo/600.css';
import '@fontsource/cairo/700.css';
import '@fontsource/cairo/900.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';

import type { Locale } from '../i18n/ui';
import { localeDir, locales, t } from '../i18n/ui';
import { buildHreflang, SITE_URL } from '../lib/seo';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  path: string;
  type?: 'website' | 'article';
  image?: string;
  publishedTime?: string;
  modifiedTime?: string;
  jsonLd?: Record<string, unknown>[];
  hideNav?: boolean;
  hideFooter?: boolean;
  lang?: string;
}

const {
  locale, title, description, path,
  type = 'website', image, publishedTime, modifiedTime,
  jsonLd = [], hideNav, hideFooter, lang,
} = Astro.props;

const dir = localeDir[locale];
const canonical = buildHreflang(locale, path);
const ogImage = image ?? `${SITE_URL}/og-image.png`;
const fullTitle = title.includes('EGY CINEMA') ? title : `${title} — EGY CINEMA`;

const otherLocale = locales.find((l) => l !== locale)!;
const altHref = buildHreflang(otherLocale, path);

const navLinks = [
  { href: `/${locale}#features`, label: t(locale, 'nav.features') },
  { href: `/${locale}#install`, label: t(locale, 'nav.download') },
  { href: `/${locale}/changelog`, label: t(locale, 'nav.changelog') },
];
---

<!doctype html>
<html lang={lang ?? locale} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#131313" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={t(locale, 'site.keywords')} />
    <link rel="canonical" href={canonical} />

    <link rel="alternate" hreflang={locale} href={canonical} />
    <link rel="alternate" hreflang={otherLocale} href={altHref} />
    <link rel="alternate" hreflang="x-default" href={buildHreflang('en', path)} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="EGY CINEMA" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={locale === 'ar' ? 'ar_EG' : 'en_US'} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd.map((obj) => (
      <script type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}
  </head>

  <body>
    <div class="site-bg" aria-hidden="true">
      <div class="site-bg__grid">
        <img src="/images/login/tt0816692.jpg" alt="" loading="lazy" decoding="async" />
        <img src="/images/login/tt11378946.jpg" alt="" loading="lazy" decoding="async" />
        <img src="/images/login/tt12042730.jpg" alt="" loading="lazy" decoding="async" />
        <img src="/images/login/tt15239678.jpg" alt="" loading="lazy" decoding="async" />
        <img src="/images/login/tt1745960.jpg" alt="" loading="lazy" decoding="async" />
        <img src="/images/login/tt1757678.jpg" alt="" loading="lazy" decoding="async" />
        <img src="/images/login/tt26443616.jpg" alt="" loading="lazy" decoding="async" />
        <img src="/images/login/tt30144839.jpg" alt="" loading="lazy" decoding="async" />
        <img src="/images/login/tt30460310.jpg" alt="" loading="lazy" decoding="async" />
        <img src="/images/login/tt30825738.jpg" alt="" loading="lazy" decoding="async" />
        <img src="/images/login/tt34378301.jpg" alt="" loading="lazy" decoding="async" />
        <img src="/images/login/tt37287335.jpg" alt="" loading="lazy" decoding="async" />
      </div>
      <div class="site-bg__overlay"></div>
      <div class="site-bg__grain"></div>
      <div class="site-bg__vignette"></div>
    </div>
    {!hideNav && (
      <header class="site-nav container">
        <a href={`/${locale}`} class="site-nav__brand" aria-label="EGY CINEMA home">
          <img src="/logo.png" alt="EGY CINEMA" width="28" height="28" style="border-radius: 6px; display: block;" />
          EGY CINEMA
        </a>
        <nav aria-label="Primary">
          <ul class="site-nav__links">
            {navLinks.map((l) => (
              <li><a href={l.href}>{l.label}</a></li>
            ))}
            <li class="lang-switch" aria-label="Language switcher">
              <a href={canonical} aria-current={locale === 'en' ? 'true' : 'false'} hreflang="en">EN</a>
              <span aria-hidden="true">·</span>
              <a href={altHref} aria-current={locale === 'ar' ? 'true' : 'false'} hreflang="ar">AR</a>
            </li>
          </ul>
        </nav>
      </header>
    )}

    <main id="main">
      <slot />
    </main>

    {!hideFooter && (
      <footer class="site-footer">
        <div class="container site-footer__row">
          <span>{t(locale, 'footer.copy').replace('{year}', String(new Date().getFullYear()))}</span>
          <ul class="site-footer__links">
            <li><a href="https://github.com/Youssf-Mohamed/movie_app" rel="noopener">{t(locale, 'footer.links.github')}</a></li>
            <li><a href={`/${locale}/changelog`}>{t(locale, 'footer.links.changelog')}</a></li>
            <li><a href="/admin">{t(locale, 'footer.links.admin')}</a></li>
          </ul>
        </div>
      </footer>
    )}
  </body>
</html>
