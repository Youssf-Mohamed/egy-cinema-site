---
import '../styles/global.css';
import '@fontsource/cairo/400.css';
import '@fontsource/cairo/600.css';
import '@fontsource/cairo/700.css';
import '@fontsource/cairo/900.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';

import type { Locale } from '../i18n/ui';
import { localeDir } from '../i18n/ui';

interface Props {
  title: string;
  userEmail?: string | null;
}

const { title, userEmail } = Astro.props;
const locale: Locale = 'en';
const dir = localeDir[locale];
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#131313" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} — EGY CINEMA Admin</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body>
    <div class="site-bg" aria-hidden="true">
      <div class="site-bg__track">
        <div class="site-bg__row site-bg__row--top">
          <img src="/images/login/tt0816692.jpg" alt="" loading="eager" decoding="async" fetchpriority="high" />
          <img src="/images/login/tt11378946.jpg" alt="" loading="eager" decoding="async" fetchpriority="high" />
          <img src="/images/login/tt12042730.jpg" alt="" loading="eager" decoding="async" fetchpriority="high" />
          <img src="/images/login/tt15239678.jpg" alt="" loading="eager" decoding="async" />
          <img src="/images/login/tt26443616.jpg" alt="" loading="eager" decoding="async" />
          <img src="/images/login/tt30144839.jpg" alt="" loading="lazy" decoding="async" />
          <!-- duplicate -->
          <img src="/images/login/tt0816692.jpg" alt="" loading="lazy" decoding="async" aria-hidden="true" />
          <img src="/images/login/tt11378946.jpg" alt="" loading="lazy" decoding="async" aria-hidden="true" />
          <img src="/images/login/tt12042730.jpg" alt="" loading="lazy" decoding="async" aria-hidden="true" />
          <img src="/images/login/tt15239678.jpg" alt="" loading="lazy" decoding="async" aria-hidden="true" />
          <img src="/images/login/tt26443616.jpg" alt="" loading="lazy" decoding="async" aria-hidden="true" />
          <img src="/images/login/tt30144839.jpg" alt="" loading="lazy" decoding="async" aria-hidden="true" />
        </div>
        <div class="site-bg__row site-bg__row--bottom">
          <img src="/images/login/tt1745960.jpg" alt="" loading="lazy" decoding="async" />
          <img src="/images/login/tt1757678.jpg" alt="" loading="lazy" decoding="async" />
          <img src="/images/login/tt30460310.jpg" alt="" loading="lazy" decoding="async" />
          <img src="/images/login/tt30825738.jpg" alt="" loading="lazy" decoding="async" />
          <img src="/images/login/tt34378301.jpg" alt="" loading="lazy" decoding="async" />
          <img src="/images/login/tt37287335.jpg" alt="" loading="lazy" decoding="async" />
          <!-- duplicate -->
          <img src="/images/login/tt1745960.jpg" alt="" loading="lazy" decoding="async" aria-hidden="true" />
          <img src="/images/login/tt1757678.jpg" alt="" loading="lazy" decoding="async" aria-hidden="true" />
          <img src="/images/login/tt30460310.jpg" alt="" loading="lazy" decoding="async" aria-hidden="true" />
          <img src="/images/login/tt30825738.jpg" alt="" loading="lazy" decoding="async" aria-hidden="true" />
          <img src="/images/login/tt34378301.jpg" alt="" loading="lazy" decoding="async" aria-hidden="true" />
          <img src="/images/login/tt37287335.jpg" alt="" loading="lazy" decoding="async" aria-hidden="true" />
        </div>
      </div>
      <div class="site-bg__overlay"></div>
      <div class="site-bg__grain"></div>
      <div class="site-bg__vignette"></div>
    </div>
    <header class="site-nav container">
      <a href="/admin" class="site-nav__brand" aria-label="EGY CINEMA admin">
        <img src="/logo.png" alt="EGY CINEMA" width="28" height="28" style="border-radius: 6px; display: block;" />
        EGY CINEMA
      </a>
      <nav aria-label="Admin">
        <ul class="site-nav__links">
          {userEmail && (
            <>
              <li>
                <a href="/en" target="_blank" rel="noopener">View site →</a>
              </li>
              <li style="color: var(--smoke); font-family: var(--font-slate); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase;">
                {userEmail}
              </li>
              <li>
                <form method="post" action="/api/admin/logout" style="display: inline;">
                  <button type="submit" class="link-button">Sign out</button>
                </form>
              </li>
            </>
          )}
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  .link-button {
    background: none;
    border: 0;
    padding: 0;
    color: var(--smoke);
    font: inherit;
    font-family: var(--font-slate);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    cursor: pointer;
  }
  .link-button:hover { color: var(--ochre); }
</style>
