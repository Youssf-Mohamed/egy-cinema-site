---
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
  href: string;
  platform: 'windows' | 'mac' | 'linux' | 'android' | 'ios';
  label?: string;
  variant?: 'primary' | 'secondary';
  disabled?: boolean;
  id?: string;
}

const { locale, href, platform, label, variant = 'primary', disabled, id } = Astro.props;
const buttonLabel = label ?? t(locale, 'install.download');
const className = `btn-ticket${variant === 'secondary' ? ' btn-ticket--secondary' : ''}`;
---

{disabled ? (
  <span class={className} aria-disabled="true" data-disabled="true">
    <span class="btn-ticket__stub" aria-hidden="true"></span>
    <span class="btn-ticket__text">{buttonLabel}</span>
  </span>
) : (
  <a
    class={className}
    href={href}
    rel="noopener"
    data-platform={platform}
    {...(id ? { id, 'data-download-id': id } : { 'data-download-id': '' })}
  >
    <span class="btn-ticket__stub" aria-hidden="true"></span>
    <span class="btn-ticket__icon" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
        <polyline points="7 10 12 15 17 10" />
        <line x1="12" y1="15" x2="12" y2="3" />
      </svg>
    </span>
    <span class="btn-ticket__text">{buttonLabel}</span>
    <span class="btn-ticket__sheen" aria-hidden="true"></span>
  </a>
)}
