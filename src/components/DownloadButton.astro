---
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
  href: string;
  platform: 'windows' | 'mac' | 'linux' | 'android' | 'ios';
  label?: string;
  variant?: 'primary' | 'secondary';
  disabled?: boolean;
}

const { locale, href, platform, label, variant = 'primary', disabled } = Astro.props;
const buttonLabel = label ?? t(locale, 'install.download');
const className = `btn-ticket${variant === 'secondary' ? ' btn-ticket--secondary' : ''}`;
---

{disabled ? (
  <span class={className} aria-disabled="true">{buttonLabel}</span>
) : (
  <a class={className} href={href} rel="noopener" data-platform={platform}>
    {buttonLabel}
  </a>
)}
