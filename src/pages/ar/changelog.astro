---
import Base from '../../layouts/Base.astro';
import { t } from '../../i18n/ui';
import { fetchPublishedReleases } from '../../lib/supabase';
import { buildBreadcrumbLd } from '../../lib/seo';

const locale = 'ar' as const;
const releases = await fetchPublishedReleases();

const dateFormatter = new Intl.DateTimeFormat('ar-EG', { year: 'numeric', month: 'long', day: 'numeric' });
const breadcrumbLd = buildBreadcrumbLd(locale, [
  { name: 'EGY CINEMA', path: '/' },
  { name: t(locale, 'changelog.title'), path: '/changelog' },
]);
---

<Base
  locale={locale}
  title={t(locale, 'changelog.title')}
  description={`${t(locale, 'site.name')} — ${t(locale, 'changelog.title')}`}
  path="/changelog"
  jsonLd={[breadcrumbLd]}
>
  <section class="hero changelog-hero">
    <div class="container container--narrow">
      <div class="changelog-hero__breadcrumbs">
        <a href={`/${locale}`} class="changelog-back-link" aria-label="العودة للصفحة الرئيسية">
          <svg class="changelog-back-link__icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          <span>الرئيسية</span>
        </a>
        <span class="changelog-hero__sep" aria-hidden="true">/</span>
        <span class="changelog-hero__current">{t(locale, 'nav.changelog')}</span>
      </div>
      <h1 class="hero__title" style="font-size: clamp(2.5rem, 6vw, 4rem);">{t(locale, 'changelog.title')}</h1>
      <p class="hero__tagline" style="margin-bottom: 0;">{t(locale, 'changelog.lead')}</p>
    </div>
  </section>

  <section style="padding-top: 32px;">
    <div class="container container--narrow">
      {releases.length === 0 ? (
        <p style="color: var(--smoke);">{t(locale, 'changelog.empty')}</p>
      ) : (
        <div class="changelog-list">
          {releases.map((r) => (
            <article class="changelog-release">
              <header class="changelog-release__head">
                <span class="changelog-release__version">v{r.min_version}</span>
                <time class="changelog-release__date" datetime={r.release_date}>
                  {dateFormatter.format(new Date(r.release_date))}
                </time>
              </header>
              {r.notes_html ? (
                <div class="changelog-release__body" set:html={r.notes_html} />
              ) : (
                <p style="color: var(--smoke); font-style: italic;">لا توجد ملاحظات لهذا الإصدار.</p>
              )}
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</Base>
