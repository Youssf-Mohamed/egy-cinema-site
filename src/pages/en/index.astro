---
import Base from '../../layouts/Base.astro';
import MarqueeRule from '../../components/MarqueeRule.astro';
import DownloadButton from '../../components/DownloadButton.astro';
import PlatformPills from '../../components/PlatformPills.astro';
import ReportBrokenLink from '../../components/ReportBrokenLink.astro';
import { t, featureT, type FeatureKey } from '../../i18n/ui';
import { fetchLatestRelease, platformUrl, type PlatformKey } from '../../lib/supabase';
import { buildOrganizationLd, buildSoftwareAppLd, buildFaqLd } from '../../lib/seo';

const locale = 'en' as const;
const release = await fetchLatestRelease();

const version = release?.min_version ?? '—';
const releaseDate = release?.release_date ?? new Date().toISOString();
const windowsUrl = release ? platformUrl(release, 'windows_download_url') : null;

const orgLd = buildOrganizationLd();
const appLd = release ? buildSoftwareAppLd(locale, version, releaseDate, windowsUrl) : null;

const faqItems = [
  { q: t(locale, 'faq.01.q'), a: t(locale, 'faq.01.a') },
  { q: t(locale, 'faq.02.q'), a: t(locale, 'faq.02.a') },
  { q: t(locale, 'faq.04.q'), a: t(locale, 'faq.04.a') },
  { q: t(locale, 'faq.05.q'), a: t(locale, 'faq.05.a') },
];
const faqLd = buildFaqLd(faqItems);

const formattedDate = release
  ? new Date(release.release_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : '—';

const platforms: PlatformKey[] = ['windows_download_url', 'android_download_url'];
const platformList: Array<'windows' | 'android'> = ['windows', 'android'];
// Each platform is independent — Windows users must NOT receive the APK
// just because download_url happens to be the Android URL. The legacy
// download_url column is kept as an opt-in fallback for older clients only.
const platformUrlMap: Record<'windows' | 'android', string | null> = {
  windows: release ? platformUrl(release, 'windows_download_url') : null,
  android: release ? platformUrl(release, 'android_download_url') : null,
};
// Encode as JSON so the client-side script can swap hrefs without an extra fetch
const platformData = JSON.stringify(platformUrlMap);

// Hero button label per pill (so the CTA text reflects the active platform)
const heroButtonLabels: Record<'windows' | 'android', string> = {
  windows: t(locale, 'hero.cta'),
  android: t(locale, 'hero.cta.android'),
};
const heroButtonData = JSON.stringify(heroButtonLabels);

void platforms;

// Primary CTA resolves to Windows directly (no Android fallback), and
// only falls back to the legacy column if Windows is unset.
const heroPrimaryHref = release
  ? (platformUrl(release, 'windows_download_url') ?? platformUrl(release, 'download_url') ?? `/${locale}#install`)
  : `/${locale}#install`;
---

<Base
  locale={locale}
  title={t(locale, 'site.name')}
  description={t(locale, 'site.description')}
  path="/"
  jsonLd={[orgLd, appLd, faqLd].filter(Boolean) as Record<string, unknown>[]}
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container">
      <div class="section-card section-card--hero">
        <div class="hero__inner">
          <div class="hero__content">
            <div class="hero__badge">
              <span class="hero__badge-dot" aria-hidden="true"></span>
              <span class="hero__badge-text">{t(locale, 'hero.eyebrow')}</span>
            </div>
            <h1 id="hero-title" class="hero__title">{t(locale, 'hero.title')}</h1>
            <p class="hero__tagline">{t(locale, 'hero.tagline')}</p>

            <div class="hero__perks" aria-label="Key highlights">
              <span class="hero__perk">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                100% Free
              </span>
              <span class="hero__perk">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="15" rx="2" ry="2"/><polyline points="17 2 12 7 7 2"/></svg>
                HD & 4K Streams
              </span>
              <span class="hero__perk">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                Watch Together
              </span>
              <span class="hero__perk">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                Arabic Subtitles
              </span>
            </div>

            <div class="hero__telemetry" aria-label="Release info">
              <div class="hero__telemetry-item">
                <span class="hero__telemetry-label">{t(locale, 'hero.version.label')}</span>
                <span class="hero__telemetry-value">
                  <span class="hero__telemetry-tag">v{version}</span>
                </span>
              </div>
              <div class="hero__telemetry-divider" aria-hidden="true"></div>
              <div class="hero__telemetry-item">
                <span class="hero__telemetry-label">{t(locale, 'hero.released.label')}</span>
                <span class="hero__telemetry-value">{formattedDate}</span>
              </div>
              <div class="hero__telemetry-divider" aria-hidden="true"></div>
              <div class="hero__telemetry-item">
                <span class="hero__telemetry-label">Status</span>
                <span class="hero__telemetry-value hero__telemetry-value--verified">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
                  Verified Build
                </span>
              </div>
            </div>

            <div class="hero__cta-group">
              <DownloadButton
                id="hero-download"
                locale={locale}
                href={heroPrimaryHref}
                platform="windows"
                label={t(locale, 'hero.cta')}
              />
              <p class="hero__subline">{t(locale, 'hero.subline')}</p>
            </div>

            <PlatformPills locale={locale} platforms={platformList} activePlatform="windows" buttonId="hero-download" />
          </div>
          <div class="hero__visual">
            <div class="hero__window-glow" aria-hidden="true"></div>
            <div class="hero__window">
              <div class="hero__window-bar">
                <span class="hero__window-dot hero__window-dot--red"></span>
                <span class="hero__window-dot hero__window-dot--yellow"></span>
                <span class="hero__window-dot hero__window-dot--green"></span>
                <span class="hero__window-title">EGY CINEMA — Desktop v{version}</span>
                <span class="hero__window-badge">4K ULTRA</span>
              </div>
              <div class="hero__window-media">
                <div class="hero__window-glare" aria-hidden="true"></div>
                <img src="/images/mockup/desktop-preview.webp" alt="EGY CINEMA desktop preview" loading="eager" decoding="async" fetchpriority="high" width="1018" height="932" />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section aria-labelledby="what-title">
    <div class="container">
      <div class="section-card">
        <MarqueeRule eyebrow={t(locale, 'what.title')} />
        <div class="container--narrow" style="padding: 0;">
          <h2 id="what-title">{t(locale, 'what.heading')}</h2>
          <p style="color: var(--smoke); font-size: 1.0625rem; max-width: 600px;">{t(locale, 'what.lead')}</p>
        </div>

        <div class="cards-3">
          <article class="card card--interactive">
            <div class="card__icon-wrap card__icon-wrap--crimson">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"/>
                <line x1="7" y1="2" x2="7" y2="22"/>
                <line x1="17" y1="2" x2="17" y2="22"/>
                <line x1="2" y1="12" x2="22" y2="12"/>
                <line x1="2" y1="7" x2="7" y2="7"/>
                <line x1="2" y1="17" x2="7" y2="17"/>
                <line x1="17" y1="17" x2="22" y2="17"/>
                <line x1="17" y1="7" x2="22" y2="7"/>
              </svg>
            </div>
            <div class="card__header-row">
              <h3 class="card__title">{t(locale, 'what.card.movies.title')}</h3>
              <span class="card__badge">ARCHIVE</span>
            </div>
            <p class="card__body">{t(locale, 'what.card.movies.body')}</p>
          </article>
          <article class="card card--interactive">
            <div class="card__icon-wrap card__icon-wrap--amber">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="7" width="20" height="15" rx="2" ry="2"/>
                <polyline points="17 2 12 7 7 2"/>
              </svg>
            </div>
            <div class="card__header-row">
              <h3 class="card__title">{t(locale, 'what.card.tv.title')}</h3>
              <span class="card__badge">SEASONS</span>
            </div>
            <p class="card__body">{t(locale, 'what.card.tv.body')}</p>
          </article>
          <article class="card card--interactive">
            <div class="card__icon-wrap card__icon-wrap--crimson">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
              </svg>
            </div>
            <div class="card__header-row">
              <h3 class="card__title">{t(locale, 'what.card.together.title')}</h3>
              <span class="card__badge">SYNC ROOM</span>
            </div>
            <p class="card__body">{t(locale, 'what.card.together.body')}</p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section id="features" aria-labelledby="features-title">
    <div class="container">
      <div class="section-card">
        <MarqueeRule eyebrow={t(locale, 'features.eyebrow')} />
        <div class="container--narrow" style="padding: 0;">
          <h2 id="features-title">{t(locale, 'features.title')}</h2>
          <p style="color: var(--smoke); font-size: 1.0625rem; max-width: 600px;">{t(locale, 'features.lead')}</p>
        </div>

        <div class="features-grid">
          {(['01', '02', '03', '04', '05', '06'] as FeatureKey[]).map((num) => (
            <article class="feature-card">
              <div class="feature-card__top">
                <div class="feature-card__icon" aria-hidden="true">
                  {num === '01' && (
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
                  )}
                  {num === '02' && (
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                  )}
                  {num === '03' && (
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                  )}
                  {num === '04' && (
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                  )}
                  {num === '05' && (
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                  )}
                  {num === '06' && (
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                  )}
                </div>
                <span class="feature-card__ordinal">#{num}</span>
              </div>
              <h3 class="feature-card__title">{featureT(locale, num, 'title')}</h3>
              <p class="feature-card__body">{featureT(locale, num, 'body')}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section aria-labelledby="preview-title">
    <div class="container">
      <div class="section-card">
        <MarqueeRule eyebrow={t(locale, 'preview.eyebrow')} />
        <div class="container--narrow" style="padding: 0;">
          <h2 id="preview-title">{t(locale, 'preview.title')}</h2>
          <p style="color: var(--smoke); font-size: 1.0625rem; max-width: 600px;">{t(locale, 'preview.lead')}</p>
        </div>
        <div class="preview-grid">
          <article class="preview-card">
            <div class="preview-card__media">
              <span class="preview-card__pill">01 · Discover</span>
              <img
                src="/images/mockup/mockup-01.webp"
                alt="Your Next Favorite — home screen with recommended movies"
                loading="lazy"
                decoding="async"
                width="400"
                height="711"
                sizes="(max-width: 600px) 100vw, (max-width: 900px) 50vw, 33vw"
              />
            </div>
            <div class="preview-card__body">
              <h3 class="preview-card__title">{t(locale, 'preview.01.title')}</h3>
              <p class="preview-card__desc">{t(locale, 'preview.01.body')}</p>
            </div>
          </article>
          <article class="preview-card">
            <div class="preview-card__media">
              <span class="preview-card__pill">02 · Favorites</span>
              <img
                src="/images/mockup/mockup-02.webp"
                alt="Favorites screen showing saved movies and series"
                loading="lazy"
                decoding="async"
                width="400"
                height="711"
                sizes="(max-width: 600px) 100vw, (max-width: 900px) 50vw, 33vw"
              />
            </div>
            <div class="preview-card__body">
              <h3 class="preview-card__title">{t(locale, 'preview.02.title')}</h3>
              <p class="preview-card__desc">{t(locale, 'preview.02.body')}</p>
            </div>
          </article>
          <article class="preview-card">
            <div class="preview-card__media">
              <span class="preview-card__pill">03 · Watchlist</span>
              <img
                src="/images/mockup/mockup-03.webp"
                alt="Watchlist screen showing titles saved to watch later"
                loading="lazy"
                decoding="async"
                width="400"
                height="711"
                sizes="(max-width: 600px) 100vw, (max-width: 900px) 50vw, 33vw"
              />
            </div>
            <div class="preview-card__body">
              <h3 class="preview-card__title">{t(locale, 'preview.03.title')}</h3>
              <p class="preview-card__desc">{t(locale, 'preview.03.body')}</p>
            </div>
          </article>
          <article class="preview-card">
            <div class="preview-card__media">
              <span class="preview-card__pill">04 · Watch Together</span>
              <img
                src="/images/mockup/mockup-04.webp"
                alt="Watch Together feature showing synchronized playback"
                loading="lazy"
                decoding="async"
                width="400"
                height="711"
                sizes="(max-width: 600px) 100vw, (max-width: 900px) 50vw, 33vw"
              />
            </div>
            <div class="preview-card__body">
              <h3 class="preview-card__title">{t(locale, 'preview.04.title')}</h3>
              <p class="preview-card__desc">{t(locale, 'preview.04.body')}</p>
            </div>
          </article>
          <article class="preview-card">
            <div class="preview-card__media">
              <span class="preview-card__pill">05 · Watch Party</span>
              <img
                src="/images/mockup/mockup-05.webp"
                alt="Party invite screen showing up to 4 friends"
                loading="lazy"
                decoding="async"
                width="400"
                height="711"
                sizes="(max-width: 600px) 100vw, (max-width: 900px) 50vw, 33vw"
              />
            </div>
            <div class="preview-card__body">
              <h3 class="preview-card__title">{t(locale, 'preview.05.title')}</h3>
              <p class="preview-card__desc">{t(locale, 'preview.05.body')}</p>
            </div>
          </article>
          <article class="preview-card">
            <div class="preview-card__media">
              <span class="preview-card__pill">06 · Community</span>
              <img
                src="/images/mockup/mockup-06.webp"
                alt="Comments section showing user reactions and replies"
                loading="lazy"
                decoding="async"
                width="400"
                height="711"
                sizes="(max-width: 600px) 100vw, (max-width: 900px) 50vw, 33vw"
              />
            </div>
            <div class="preview-card__body">
              <h3 class="preview-card__title">{t(locale, 'preview.06.title')}</h3>
              <p class="preview-card__desc">{t(locale, 'preview.06.body')}</p>
            </div>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section id="install" aria-labelledby="install-title">
    <div class="container">
      <div class="section-card">
        <MarqueeRule eyebrow={t(locale, 'install.eyebrow')} />
        <div class="container--narrow" style="padding: 0;">
          <h2 id="install-title">{t(locale, 'install.title')}</h2>
          <p style="color: var(--smoke); font-size: 1.0625rem; max-width: 600px;">{t(locale, 'install.lead')}</p>
        </div>

        <div data-install-pills style="display: flex; gap: 24px; align-items: center; flex-wrap: wrap; margin: 24px 0 8px;">
          <PlatformPills locale={locale} platforms={platformList} activePlatform="windows" buttonId="install-active" />
        </div>

        <div class="platform-grid" id="install-platform-grid">
          {platformList.map((p) => {
            const url = platformUrlMap[p];
            return (
              <article class={`platform-card${url ? '' : ' platform-card--disabled'}${p === 'windows' ? ' platform-card--focus' : ''}`} data-platform-card={p}>
                <div class="platform-card__header">
                  <div class="platform-card__icon" aria-hidden="true">
                    {p === 'windows' ? (
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.551H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-13.051-1.802" />
                      </svg>
                    ) : (
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M17.523 15.3414c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.551 0 .9993.4482.9993.9993.0001.5511-.4483.9997-.9993.9997m-11.046 0c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.5511 0 .9993.4482.9993.9993 0 .5511-.4482.9997-.9993.9997m11.4045-6.02l1.9973-3.4592a.416.416 0 00-.1521-.5676.416.416 0 00-.5676.1521l-2.0223 3.503C15.5902 8.4126 13.8533 8.125 12 8.125c-1.8533 0-3.5902.2876-5.1368.8247L4.8409 5.4467a.4161.4161 0 00-.5677-.1521.4157.4157 0 00-.1521.5676l1.9973 3.4592C2.6889 11.1867.3432 14.6589 0 18.761h24c-.3432-4.1021-2.6889-7.5743-6.1185-9.4396" />
                      </svg>
                    )}
                  </div>
                  <div>
                    <p class="platform-card__name">{t(locale, `install.platform.${p}`)}</p>
                    <span class="platform-card__spec">
                      {p === 'windows' ? 'Windows 10 / 11 (64-bit)' : 'Android 7.0+ (Universal APK)'}
                    </span>
                  </div>
                </div>
                <div class="platform-card__meta">
                  <span class="platform-card__version-tag">v{version}</span>
                  <span class="platform-card__date">{formattedDate}</span>
                </div>
                <div class="platform-card__cta">
                  <DownloadButton
                    id={`install-download-${p}`}
                    locale={locale}
                    href={url ?? '#'}
                    platform={p}
                    disabled={!url}
                    variant="primary"
                  />
                </div>
              </article>
            );
          })}
        </div>

        <p style="font-family: var(--font-slate); font-size: 12px; color: var(--smoke); margin-top: 24px; letter-spacing: 0.04em;">
          <a
            href="#"
            data-report-trigger
            data-report-platform=""
            data-report-version={version}
          >{t(locale, 'install.reportBroken')}</a>
        </p>
      </div>
    </div>
  </section>

  <section aria-labelledby="faq-title">
    <div class="container">
      <div class="section-card">
        <MarqueeRule eyebrow={t(locale, 'faq.eyebrow')} />
        <div class="container--narrow" style="padding: 0;">
          <h2 id="faq-title">{t(locale, 'faq.title')}</h2>
          <div class="faq-list">
            {faqItems.map((it, idx) => (
              <details class="faq-item" open={idx === 0}>
                <summary class="faq-item__q">
                  <span>{it.q}</span>
                  <span class="faq-item__icon" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </span>
                </summary>
                <div class="faq-item__content">
                  <p class="faq-item__a">{it.a}</p>
                </div>
              </details>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <ReportBrokenLink locale={locale} version={version} />

  <script is:inline define:vars={{ platformData, heroButtonData }}>
    (function () {
      const urls = JSON.parse(platformData);
      const labels = JSON.parse(heroButtonData);
      const fallback = Object.values(urls).find(Boolean) || '#';
      const buttons = document.querySelectorAll('a[data-download-id]');
      const byPlatform = new Map();
      buttons.forEach((btn) => {
        if (btn.dataset.downloadId) byPlatform.set(btn.dataset.downloadId, btn);
      });

      function setActive(targetId, platform) {
        const btn = byPlatform.get(targetId);
        if (!btn) return;
        btn.href = urls[platform] || fallback;
        btn.dataset.platform = platform;
        const textSpan = btn.querySelector('.btn-ticket__text');
        if (textSpan && labels && labels[platform]) {
          textSpan.textContent = labels[platform];
        } else if (labels && Object.prototype.hasOwnProperty.call(labels, platform)) {
          for (const node of btn.childNodes) {
            if (node.nodeType === Node.TEXT_NODE) {
              node.nodeValue = labels[platform];
              return;
            }
          }
          btn.appendChild(document.createTextNode(labels[platform]));
        }
      }

      function wirePills(group, onChange) {
        if (!group) return;
        const pills = group.querySelectorAll('.platform-pill[data-platform]');
        pills.forEach((pill) => {
          pill.addEventListener('click', () => {
            pills.forEach((p) => {
              p.classList.toggle('platform-pill--active', p === pill);
              p.setAttribute('aria-selected', p === pill ? 'true' : 'false');
            });
            onChange(pill.dataset.platform);
          });
        });
      }

      // Hero pills control the hero download button
      document.querySelectorAll('.platform-pills').forEach((group) => {
        const targetId = group.dataset.pills;
        if (!targetId) return;
        wirePills(group, (platform) => setActive(targetId, platform));
      });

      // Install section: pills control which platform card is "focused"
      const installGrid = document.getElementById('install-platform-grid');
      const installPills = document.querySelector('[data-install-pills]');
      if (installGrid && installPills) {
        wirePills(installPills, (platform) => {
          installGrid.querySelectorAll('[data-platform-card]').forEach((card) => {
            card.classList.toggle('platform-card--focus', card.dataset.platformCard === platform);
          });
        });
      }
    })();
  </script>
</Base>
