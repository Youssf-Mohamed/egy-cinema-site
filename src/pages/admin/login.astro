---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';

const url = new URL(Astro.request.url);
const error = url.searchParams.get('error');
const errorMsg = error === 'invalid' || error === 'not_admin'
  ? 'Wrong email or password, or this account is not an admin.'
  : error === 'missing'
  ? 'Please enter your email and password.'
  : null;
---

<AdminLayout title="Sign in">
  <div class="login">
    <h1 class="login__title">Admin sign in</h1>

    {errorMsg && <div class="form__error" style="margin-bottom: 16px;">{errorMsg}</div>}

    <form method="post" action="/api/admin/login" class="form">
      <div class="form__field">
        <label class="form__label" for="email">Email</label>
        <input class="form__input" type="email" id="email" name="email" autocomplete="email" required autofocus />
      </div>
      <div class="form__field">
        <label class="form__label" for="password">Password</label>
        <input class="form__input" type="password" id="password" name="password" autocomplete="current-password" required />
      </div>
      <button type="submit" class="btn-ticket" style="width: 100%; justify-content: center; padding: 14px;">
        Sign in
      </button>
    </form>
  </div>
</AdminLayout>
